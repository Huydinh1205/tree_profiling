# Only the processing code goes to GitHub. No data, no results.
# Everything at the top level is ignored except these:
/*
!/.gitignore
!/README.md
!/processes/

# Inside processes/: never commit outputs, examples or environments
processes/results/
processes/examples/
processes/data/
.venv/
venv/
__pycache__/
*.pyc
*.nbi
*.nbc
.fuse_hidden*
.DS_Store
Thumbs.db

# Point clouds, rasters and GIS outputs, wherever they are
*.las
*.laz
*.copc.laz
*.ply
*.e57
*.tif
*.tiff
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.zip

# Exception: the small public RMIT benchmark data (FOR-instance, CC BY 4.0) as LAZ
!/data/
/data/*
!/data/RMIT/
/data/RMIT/*
!/data/RMIT/train.laz
!/data/RMIT/test.laz
!/data/RMIT/train_test.laz
!/data/RMIT/tree_data_RMIT.csv
!/data/RMIT/README.md
